# Caddy as the public web server: the only container reachable from the internet.
#
# HTTPS certificates are requested from Let's Encrypt automatically and renewed
# for you. For APP_DOMAIN=localhost Caddy uses its own local CA instead (browser
# warning, `curl -k`), which is what you want on a development machine.
#
# Already running nginx/Apache on ports 80/443? Use Caddyfile.behind-proxy instead
# (docker/setup.sh asks; see "Behind an existing web server" in docs/DEPLOY.md).
#
# APP_DOMAIN and ACME_EMAIL come from .env (compose.yaml passes them in).
{
	email {$ACME_EMAIL}

	# While experimenting with a real domain, un-comment the next line to avoid
	# hitting Let's Encrypt rate limits. Browsers will not trust the staging certificates.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$APP_DOMAIN} {
	import /etc/caddy/site.caddy
}

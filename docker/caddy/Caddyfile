# Caddy: the only container that is reachable from the internet.
#
#   https://{$APP_DOMAIN}/forum*  ->  flarum:8000   (the forum, served under the /forum sub-path)
#   https://{$APP_DOMAIN}/*       ->  app:8080      (the Laravel app)
#
# HTTPS certificates are requested from Let's Encrypt automatically and renewed
# for you. For APP_DOMAIN=localhost Caddy uses its own local CA instead (browser
# warning, `curl -k`), which is what you want on a development machine.
#
# APP_DOMAIN and ACME_EMAIL come from .env (compose.yaml passes them in).
{
	email {$ACME_EMAIL}

	# While experimenting with a real domain, un-comment the next line to avoid
	# hitting Let's Encrypt rate limits. Browsers will not trust the staging certificates.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$APP_DOMAIN} {
	encode zstd gzip

	# Design / driver uploads can be big. nginx + PHP (UPLOAD_MAX_SIZE in .env) enforce the
	# real per-file limit; this is just a ceiling so nothing absurd is streamed to the app.
	request_body {
		max_size 1GB
	}

	log {
		output stdout
	}

	header {
		# `defer` makes these win over the same headers sent by the upstream containers.
		defer
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# Same-origin framing only: the design/driver pages embed /forum/embed/... in an iframe.
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}

	# --- Flarum, served under /forum --------------------------------------
	# Flarum is configured with its public URL https://{$APP_DOMAIN}/forum and expects to see
	# the full /forum/... path on every request, so the prefix is NOT stripped, except for
	# /forum/assets/* (compiled JS/CSS, avatars): those are plain files that live in the
	# document root of the Flarum container, i.e. at /assets/..., not /forum/assets/...
	handle /forum/assets/* {
		uri strip_prefix /forum
		reverse_proxy flarum:8000 {
			lb_try_duration 5s
		}
	}

	@forum path /forum /forum/*
	handle @forum {
		reverse_proxy flarum:8000 {
			lb_try_duration 5s
		}
	}

	# --- Everything else: the Laravel app -----------------------------------
	handle {
		reverse_proxy app:8080 {
			# Ride out container restarts during `docker compose up -d` instead of showing a 502.
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}
}

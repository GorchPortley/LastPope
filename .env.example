APP_NAME=SDLabs
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite uses database/database.sqlite by default (create the empty file first).
DB_CONNECTION=sqlite
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_DATABASE=database
#DB_USERNAME=root
#DB_PASSWORD=

# Laravel's own event broadcasting. Nothing in the app uses it yet; Chatify (live chat) has its own settings (REVERB_*, below).
BROADCAST_CONNECTION=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=9999

# Search: "database" needs no external service; use "algolia"/"meilisearch" in production if wanted.
SCOUT_DRIVER=database

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Live chat (Chatify) over Laravel Reverb, our own WebSocket server --------------------------
# Self-hosted replacement for pusher.com: nothing is sent to a third party. In Docker the `reverb`
# service runs it and docker/setup.sh generates the three values below (the secret stays on the
# server; browsers only ever get the key). For plain `php artisan serve` development put the same
# kind of values here (any numbers/letters) and run `php artisan reverb:start` next to the site.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where PHP reaches Reverb (compose.yaml sets reverb / 8080 / http inside Docker; this is the local default).
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# URL prefix of the server: the WebSocket is wss://DOMAIN/ws/app/<key>. Keeps it clear of the site's own routes.
REVERB_SERVER_PATH=/ws
# Where BROWSERS reach Reverb. Leave unset: https APP_URL -> wss://<APP_URL host>:443 (through the web server);
# http APP_URL (local development) -> ws://<APP_URL host>:8080. Override only for an unusual setup.
#REVERB_CLIENT_HOST=
#REVERB_CLIENT_PORT=
#REVERB_CLIENT_SCHEME=
# Hosts whose pages may open a WebSocket (default: the host of APP_URL). Comma separated; * = any site.
#REVERB_ALLOWED_ORIGINS=
# Optional: use pusher.com instead of Reverb. Then set CHATIFY_DRIVER=pusher and fill in the PUSHER_* values.
# (If you ever put a Pusher secret in an older .env, remove it and rotate it at pusher.com: the old chat page
# printed the secret into the HTML.)
#CHATIFY_DRIVER=pusher
#PUSHER_APP_ID=
#PUSHER_APP_KEY=
#PUSHER_APP_SECRET=
#PUSHER_APP_CLUSTER=mt1

JWT_SECRET=SeCrEtKeY

WAVE_DEMO=false

# Add the Google Analytics Property ID (instructions can be found here: https://github.com/spatie/laravel-analytics)
ANALYTICS_PROPERTY_ID=ID_NUM

# BILLING CREDENTIALS
BILLING_PROVIDER=stripe

PADDLE_VENDOR_ID=999
PADDLE_API_KEY=999
PADDLE_ENV=sandbox
PADDLE_PUBLIC_KEY=test_...
PADDLE_WEBHOOK_SECRET=pdl_...

# Platform keys: used by Wave's subscriptions AND by the marketplace (Stripe Connect payments and payouts).
# Without STRIPE_SECRET_KEY the local environment falls back to a fake payment gateway (a warning is logged).
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of Wave's subscription webhook (POST /webhook/stripe). The marketplace webhooks use their own, see below.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Docker / hosting ---------------------------------------------------------
# Read by compose.yaml, docker/caddy/Caddyfile and docker/setup.sh. Run docker/setup.sh once: it
# asks for the domain and fills in every empty value below with strong random secrets.
# Not needed for plain `php artisan serve` development.
# Inside Docker, compose.yaml wires the rest by itself (APP_URL, DB_*, REDIS_HOST, CACHE/SESSION/
# QUEUE drivers, FLARUM_URL): the MARIADB_* values below become DB_DATABASE / DB_USERNAME /
# DB_PASSWORD in the app containers, and REDIS_PASSWORD (above) is used by Redis and the app.
# Avoid  $ " ' \ #  and spaces in passwords (docker/setup.sh only generates letters and digits).

# Public domain name without "https://". Its DNS A record must point at the server.
# Use "localhost" to try the stack on your own computer.
APP_DOMAIN=localhost
# Contact address for Let's Encrypt (certificate expiry warnings); also the first forum admin's e-mail.
ACME_EMAIL=
# Who answers on ports 80/443. Default: Caddy (in Docker) is the public web server and gets HTTPS
# certificates itself. If nginx/Apache/Webmin already runs on this machine, docker/setup.sh switches
# to CADDY_CONFIG=Caddyfile.behind-proxy, CADDY_HTTP_BIND=127.0.0.1:8880, CADDY_HTTPS_BIND=127.0.0.1:8443
# and your web server forwards the domain to http://127.0.0.1:8880 (see docs/DEPLOY.md).
CADDY_CONFIG=Caddyfile
# Docker only: "production" (default) or "demo". With demo, `php artisan db:seed --force` also adds the
# demo users, designs, drivers and listings. On a server the public can reach, set DEMO_PASSWORD
# first: otherwise anyone can log in as admin@sdlabs.test with "password".
STACK_ENV=production
DEMO_PASSWORD=
CADDY_HTTP_BIND=80
CADDY_HTTPS_BIND=443
# Largest single upload: PHP upload_max_filesize / post_max_size and nginx client_max_body_size.
UPLOAD_MAX_SIZE=256M
# Time zone of the containers (optional).
#TZ=UTC

# MariaDB: the app database. (The forum gets its own database and user, see FLARUM_DB_* below.)
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=lastpope
MARIADB_USER=lastpope
MARIADB_PASSWORD=

# Development only (compose.dev.yaml): your user/group id, so bind-mounted files stay writable.
#DEV_UID=1000
#DEV_GID=1000
#COMPOSE_FILE=compose.yaml:compose.dev.yaml

# --- Forum (Flarum) -----------------------------------------------------------
# Flarum runs in its own container; Caddy serves it under the /forum sub-path of the main domain.
# Mail: Flarum copies the MAIL_* settings above into its own settings on its first start.

# false = the app does not talk to Flarum at all (default for development without Docker).
FORUM_ENABLED=false
# Public URL of the forum. Must be APP_URL + /forum: the single-sign-on cookie is scoped to /forum.
# In Docker this is set from APP_DOMAIN by compose.yaml.
FLARUM_URL=https://localhost/forum
# URL the Laravel containers use to call the Flarum API (container-to-container, no TLS, same
# /forum path). Only change it if you move the forum to another host.
FLARUM_INTERNAL_URL=http://flarum:8000/forum
# Master API key (letters and digits, 32-100 characters). The flarum container stores it in the
# forum database when it starts; the app sends it as  Authorization: Token <key>; userId=<n>
FLARUM_API_KEY=
# Slugs of the forum tags used for the automatic discussions (created by `php artisan forum:setup`).
FORUM_DESIGN_TAG=designs
FORUM_DRIVER_TAG=drivers
FORUM_LISTING_TAG=marketplace
# Seconds `php artisan forum:seed-demo` waits when Flarum answers "slow down" (one post per member per 10 seconds).
#FORUM_THROTTLE_WAIT=11

# Settings of the flarum and mariadb containers (compose.yaml only; the app does not read these).
FLARUM_FORUM_TITLE="Community Forum"
# First forum administrator, created automatically on the very first start.
FLARUM_ADMIN_USER=forumadmin
FLARUM_ADMIN_EMAIL=
FLARUM_ADMIN_PASSWORD=
FLARUM_DB_DATABASE=flarum
FLARUM_DB_USERNAME=flarum
FLARUM_DB_PASSWORD=
# Extra Flarum 1.x extensions to install (composer names, space separated). The default is just the
# embed extension; if you set this, include it: "flarum/embed:^1.8 fof/upload:^1.0"
#FLARUM_EXTENSIONS="flarum/embed:^1.8"

# --- Marketplace ---
MARKETPLACE_CURRENCY=usd
# Platform fee on item subtotals (not shipping): bps / 10000 + fixed cents. 1000 bps = 10 %.
MARKETPLACE_FEE_BPS=1000
MARKETPLACE_FEE_FIXED_CENTS=0
# When a seller of physical goods is paid out:
#   shipped_delay  N days after the seller marks the parcel shipped (default, protects buyers; see the delay below)
#   shipped        as soon as the seller marks the parcel shipped
#   paid           as soon as the payment succeeds
# An unresolved problem report ("Report a problem") always holds the payout back.
MARKETPLACE_PHYSICAL_PAYOUT_TRIGGER=shipped_delay
MARKETPLACE_PHYSICAL_PAYOUT_DELAY_DAYS=14
# Shipped orders complete by themselves after this many days (not while a problem is open).
MARKETPLACE_AUTO_COMPLETE_DAYS=14
# Buyers can report a problem until this many days after shipping (digital items: after payment).
MARKETPLACE_ISSUE_WINDOW_DAYS=14
# Buyer and seller get this many days to agree before either may escalate a problem to the admins.
MARKETPLACE_ISSUE_ESCALATION_DAYS=3
MARKETPLACE_STRIPE_TAX=false
# Minutes a started checkout holds the stock (30 to 1440, Stripe's Checkout Session limits).
MARKETPLACE_RESERVATION_MINUTES=30
MARKETPLACE_DEFAULT_COUNTRY=US
MARKETPLACE_ORDER_PREFIX=SDL
# Signing secrets of the two marketplace webhook endpoints (STRIPE_SECRET_KEY / STRIPE_PUBLISHABLE_KEY above are shared).
#   POST /stripe/marketplace/webhook  (payments, refunds, disputes) -> STRIPE_MARKETPLACE_WEBHOOK_SECRET
#   POST /stripe/connect/webhook      (seller account updates)    -> STRIPE_CONNECT_WEBHOOK_SECRET
# While a secret is empty its endpoint answers 503 and ignores everything.
STRIPE_MARKETPLACE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

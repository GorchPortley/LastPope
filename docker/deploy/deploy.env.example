# Settings for the automatic updater (docker/deploy/auto-deploy.sh).
#
# Copy this file to deploy.env (`sudo docker/deploy/install.sh` does that for you), remove the
# leading # from a line to change it. EVERY setting is optional: with an empty file the updater
# deploys the branch that is checked out on the server, once the GitHub tests are green.
#
# Rules: one KEY=value per line, no spaces around =, no comments after a value (comment lines on
# their own are fine), no quotes needed. deploy.env is git-ignored and may hold secrets
# (GITHUB_TOKEN, NOTIFY_URL): keep it private (chmod 600).
# Full guide: docs/DEPLOY.md, section "Automatic updates".

# --- What to deploy --------------------------------------------------------------------------

# Branch to follow. Default: the branch that is checked out on the server now.
#DEPLOY_BRANCH=main

# true: deploy a commit only after the GitHub Actions workflow below succeeded for exactly that
# commit. false: deploy every new commit as soon as it arrives (no GitHub API calls at all).
#REQUIRE_CI=true

# Name of the workflow file in .github/workflows/ that must pass.
#CI_WORKFLOW=tests.yml

# owner/name of the GitHub repository. Default: worked out from `git remote get-url origin`.
#GITHUB_REPO=YourName/LastPope

# Only for a PRIVATE repository: a fine-grained personal access token with read-only access to
# this one repository and the permission "Actions: Read-only". Without it GitHub answers 404.
# (Fetching a private repository's code needs its own access, e.g. an SSH deploy key.)
#GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Minutes to wait for a CI run to show up for a new commit before you get a warning.
#CI_WAIT_MAX=45

# --- Messages to your phone ------------------------------------------------------------------

# Where to send "Deployed ...", "Deploy failed ..." and warnings (one POST per message):
#   ntfy:    https://ntfy.sh/your-hard-to-guess-topic   (install the free ntfy app, subscribe to it)
#   Discord: a webhook URL (https://discord.com/api/webhooks/...)
# Leave empty for no notifications; everything is still written to the log.
#NOTIFY_URL=

# --- Backups, health check, rollback ----------------------------------------------------------

# Database dump taken before every deploy (both databases, gzip'd). Default: <repo>/backups
#BACKUP_DIR=/var/backups/lastpope

# How many of the newest dumps to keep.
#BACKUP_KEEP=10

# Address that must answer (HTTP 200-399) after a deploy. Default: the port Caddy publishes
# (CADDY_HTTP_BIND in .env, or 80) on 127.0.0.1, with APP_DOMAIN from .env as the Host header.
#HEALTH_URL=http://127.0.0.1:8880/

# Seconds to wait for the containers to become healthy, and the services that must be healthy
# (services that do not exist in your compose files are ignored).
#HEALTH_TIMEOUT=180
#HEALTH_SERVICES=app flarum flarum-scheduler queue scheduler

# true: when the new version is unhealthy, put the previous code back and restart it.
# (Database changes are not undone; the backup file named in the message is the way back.)
#ROLLBACK_ON_FAILURE=true

# --- Rarely needed ----------------------------------------------------------------------------

# If an automatic build stops with "Could not authenticate against github.com" (GitHub limits
# anonymous downloads of PHP packages), give composer a token here. A classic token with NO scopes
# is enough (https://github.com/settings/tokens). It is passed to the image build as a secret.
#COMPOSER_AUTH={"github-oauth":{"github.com":"ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}}

# Where the updater writes its history.
#DEPLOY_LOG=/var/log/lastpope-deploy.log

# GitHub API address (change only for GitHub Enterprise Server).
#GITHUB_API_URL=https://api.github.com

/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.phpunit.result.cache
.phpunit.cache
/database/*.sqlite
/auth.json
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/.idea
/.vscode
/.fleet
.DS_Store
/data/*
# Wave ignores.
/public/.well-known
/public/demo
/.vagrant
/wave-pro
/wave/vendor/
/public/wave/docs
/storage/app/analytics
/packages
storage/app/livewire-tmp
resources/themes/.gitignore
/storage/app/public/livewire-tmp

# Uploaded files (the demo images and the default chatify avatar are kept)
/storage/app/public/*
!/storage/app/public/demo
!/storage/app/public/users-avatar
/storage/app/public/users-avatar/*
!/storage/app/public/users-avatar/avatar.png

# Private uploads and generated files
/storage/app/private

# Ignore everything inside the resources/plugins folder, except the manifest
/resources/plugins/*
!/resources/plugins/installed.json

# Assets published by Filament and its plugins (regenerated by `php artisan filament:upgrade`,
# which composer runs on post-autoload-dump)
/public/css/filament
/public/js/filament
/public/css/awcodes
/public/js/awcodes
/public/css/bezhansalleh
/public/js/bezhansalleh

# Livewire serves its own JS through a route; a stale published copy would be used instead of the installed version
/public/vendor/livewire

# Private files (design/driver source files and snapshot ZIPs; never public)
/storage/app/private
app/analytics/service-account-credentials.json
/config/analytics.php

# Server-only files (never committed): local compose tweaks, auto-deploy settings, database dumps
/compose.override.yaml
/docker/deploy/deploy.env
/backups/

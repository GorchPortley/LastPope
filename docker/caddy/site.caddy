# Routing shared by both Caddy front-ends (imported inside their site block):
#
#   /forum*      ->  flarum:8000   (the forum, Flarum 2, served under the /forum sub-path)
#   /ws/app/*    ->  reverb:8080   (live chat: Laravel Reverb WebSocket server)
#   /*           ->  app:8080      (the Laravel app)
#
# Caddyfile               - Caddy is the public web server and gets HTTPS certificates itself.
# Caddyfile.behind-proxy  - another web server on the host (nginx, Apache, Webmin) handles HTTPS
#                           and forwards plain HTTP to Caddy on a local port.

encode zstd gzip

# Design / driver uploads can be big. nginx + PHP (UPLOAD_MAX_SIZE in .env) enforce the
# real per-file limit; this is just a ceiling so nothing absurd is streamed to the app.
request_body {
	max_size 1GB
}

log {
	output stdout
}

# HSTS only for real domains: a browser remembers it per host name (any port), which would
# force https on every other project you run at http://localhost:<port>.
@public not host localhost
header @public {
	defer
	Strict-Transport-Security "max-age=31536000"
}

header {
	# `defer` makes these win over the same headers sent by the upstream containers.
	defer
	X-Content-Type-Options "nosniff"
	# Same-origin framing only: the design/driver pages embed /forum/embed/... in an iframe.
	X-Frame-Options "SAMEORIGIN"
	Referrer-Policy "strict-origin-when-cross-origin"
	-Server
	-X-Powered-By
}

# --- Flarum, served under /forum --------------------------------------
# Flarum is configured with its public URL https://{$APP_DOMAIN}/forum and expects to see the full
# /forum/... path on every request, so the prefix is NOT stripped. The nginx in the flarum container
# understands it: /forum/assets/* (compiled JS/CSS, avatars, uploads) are plain files in Flarum's
# public/assets directory, everything else under /forum (pages, /forum/api, /forum/embed/<id>, ...) goes to
# Flarum's front controller. Nothing special is needed here.
@forum path /forum /forum/*
handle @forum {
	reverse_proxy flarum:8000 {
		lb_try_duration 5s
	}
}

# --- Live chat: Laravel Reverb (WebSocket), served under /ws -------------
# The browser opens wss://DOMAIN/ws/app/<key>; Caddy forwards the WebSocket upgrade by itself. Reverb
# is configured with the same /ws prefix (REVERB_SERVER_PATH) and expects to see it, so it is NOT
# stripped. Only this WebSocket endpoint is public: Reverb's HTTP API (/ws/apps/..., signed with the
# secret) is for the app and queue containers and is deliberately not routed here, so from outside it
# falls through to the app below and answers 404. lb_try_duration: ride out a `reverb` restart.
@reverb path /ws/app/*
handle @reverb {
	reverse_proxy reverb:8080 {
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}

# --- Everything else: the Laravel app -----------------------------------
handle {
	reverse_proxy app:8080 {
		# Ride out container restarts during `docker compose up -d` instead of showing a 502.
		lb_try_duration 10s
		lb_try_interval 250ms
	}
}
